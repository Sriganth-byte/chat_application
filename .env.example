# Django Settings
SECRET_KEY=your-django-secret-key-here-generate-with-python-manage.py-shell
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Supabase PostgreSQL Database
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Redis Configuration
REDIS_URL=redis://localhost:6379
CACHES_URL=redis://localhost:6379/1
USE_REDIS_CHANNEL_LAYER=True

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_LIFETIME=30
JWT_REFRESH_TOKEN_LIFETIME=7

# Supabase Storage
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here
SUPABASE_BUCKET=media-files

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Email Settings (Development - Console backend)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@mindconnect.com

# File Upload Limits (100MB)
MAX_UPLOAD_SIZE=104857600
ALLOWED_UPLOAD_EXTENSIONS=.jpg,.jpeg,.png,.webp,.pdf,.doc,.docx,.txt,.mp3,.wav,.mp4,.mov,.avi

# Frontend URL (for email links, etc.)
FRONTEND_URL=http://localhost:3000

# Optional frontend WebRTC ICE servers. STUN works on most LANs; add a TURN
# server here for reliable calls across different networks/NATs.
# VITE_RTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
